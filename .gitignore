# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Cursor/AI files
.cursor/
.vscode/
*.swp
*.swo
*.code-search
__pycache__/
*.bak
*.tmp
*.log

# AI writing, snapshots, and local tool/runtime state
*.cursor
*.agent-cache
*.skill-cache
*.session
*.annotate
*.prompter
*.completion
*.copilot/*
*.copilot*
/copilot-*
/ai-experiments/
ai-generated/*
/.snapshots/
/.snapshots-*/ # some extensions use this for local session states
.idea/
*.dmp

# Playwright/test outputs
/playwright-report/
/.playwright-mcp/
/test-results/
/test-report/

# Prettier/ESLint cache
.prettierignore
.prettierrc*
eslintcache

# OS junk (repeated for completeness)
*.DS_Store
Thumbs.db
Icon?AGENTS.md
CLAUDE.md
